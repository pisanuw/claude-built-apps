{
  "name": "delivery-canary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Delivery Canary: checks that a digital shop's download email reaches the inbox, not Promotions or Spam, and that its link still opens the right file.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/build-function.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test e2e scripts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "postal-mime": "4.2.0",
    "undici": "6.29.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
