{
  "name": "poincare-paint",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Poincaré Paint: draw in the Poincaré disk and every stroke is replicated across a hyperbolic {p,q} tiling with Möbius maps. Drag to re-center, geodesic brush, distance and angle-sum measuring, SVG export and share links. Entirely client-side.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
