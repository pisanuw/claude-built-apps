# tagging-doctor-worker settings. None is a secret; production values are in
# deploy/target.yml `env`.
SUPABASE_URL=https://auth.hintwise.org
SUPABASE_ANON_KEY=
# Also give CORS permission to http://localhost:5173 (the app's dev server).
ALLOW_LOCAL=
# Render sets PORT; the image's default is 10000.
PORT=10000
# In the image: /jobs, the TeX user 10001, the caches in /opt/texmf-var.
# Outside the image, for a local run without TeX: TEX_UID=none TEX_CACHE=none.
JOBS_ROOT=/jobs
TEX_UID=10001
TEX_CACHE=/opt/texmf-var
# A shorter job limit for tests; never more than 120000.
JOB_LIMIT_MS=
