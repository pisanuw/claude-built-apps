# Public client values, copied from platform/supabase.json once the owner has
# run the "Supabase admin" workflow's `keys` command. Public by design: the
# anon key only reaches rows that row level security allows. Vite reads VITE_*
# at build time; in production target.yml's `env` sets them.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Compile and check (milestone 3b): the HintWise checker's address, one value,
# with or without a path (the Render service tagging-doctor-worker; from
# milestone 4 a path under backend-hub), and the build flag that shows the
# button: "on" or "off". Both are public. Without both, the page offers no
# compile. In production deploy/target.yml sets them.
VITE_CHECKER_URL=
VITE_COMPILE_CHECK=off

# "Compile patched and compare" (milestone 4, AC-42, AC-80): "on" builds the
# control and its script into the page; "off", or unset, leaves both out of the
# build. It needs Compile and check (above) too. Off in production until the
# tagged job passes on the live checker in backend-hub (AC-80, CR-13).
VITE_COMPARE_PATCHED=off
