{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tagging-doctor.hintwise.org/report.schema.json",
  "title": "Tagging Doctor scan report",
  "description": "The file \"Download JSON\" gives (format tagging-doctor-report/1). One report holds one document, or every document after \"Scan all\".",
  "type": "object",
  "required": ["format", "tool", "generatedAt", "project", "data", "caveat", "projectWarnings", "documents"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "tagging-doctor-report/1" },
    "tool": {
      "type": "object",
      "required": ["name", "url"],
      "additionalProperties": false,
      "properties": { "name": { "type": "string" }, "url": { "type": "string" } }
    },
    "generatedAt": { "type": "string", "description": "When the report was made, UTC, ISO 8601." },
    "project": {
      "type": "object",
      "required": ["name", "leftOut"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "description": "The dropped file's name." },
        "leftOut": { "type": "array", "items": { "type": "string" }, "description": "Files named like student records, left out and never read." }
      }
    },
    "data": {
      "type": "object",
      "description": "The package status data the scan used.",
      "required": ["asOf", "source", "page", "commit", "licence", "note"],
      "additionalProperties": false,
      "properties": {
        "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "source": { "type": "string" },
        "page": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "licence": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "caveat": { "type": "string" },
    "projectWarnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "path", "message"],
        "additionalProperties": false,
        "properties": {
          "rule": { "enum": ["unsafe-path", "student-records", "unreadable", "too-large-to-read"] },
          "path": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "documents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/document" } }
  },
  "$defs": {
    "group": { "enum": ["blocker", "warning", "unknown", "ok"] },
    "document": {
      "type": "object",
      "required": ["mainFile", "ok", "summary", "findings", "figures", "filesRead"],
      "additionalProperties": false,
      "properties": {
        "mainFile": { "type": "string" },
        "ok": { "const": true },
        "summary": {
          "type": "object",
          "required": ["verdict", "blockers", "warnings", "unknown", "ok", "notes"],
          "additionalProperties": false,
          "properties": {
            "verdict": { "type": "string", "pattern": "^(No known blockers|1 blocker found|[0-9]+ blockers found)$" },
            "blockers": { "type": "integer", "minimum": 0 },
            "warnings": { "type": "integer", "minimum": 0 },
            "unknown": { "type": "integer", "minimum": 0 },
            "ok": { "type": "integer", "minimum": 0 },
            "notes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "figures": {
          "type": "object",
          "required": ["images", "imagesWithoutAlt", "tikz", "tikzWithoutAlt", "list"],
          "additionalProperties": false,
          "properties": {
            "images": { "type": "integer", "minimum": 0 },
            "imagesWithoutAlt": { "type": "integer", "minimum": 0 },
            "tikz": { "type": "integer", "minimum": 0 },
            "tikzWithoutAlt": { "type": "integer", "minimum": 0 },
            "list": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["kind", "path", "line", "hasAlt"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "enum": ["image", "tikz"] },
                  "path": { "type": "string" },
                  "line": { "type": "integer", "minimum": 1 },
                  "file": { "type": "string" },
                  "hasAlt": { "type": "boolean" }
                }
              }
            }
          }
        },
        "filesRead": { "type": "array", "items": { "type": "string" } }
      }
    },
    "finding": {
      "type": "object",
      "required": ["severity", "rule", "path", "line", "message", "fix"],
      "additionalProperties": false,
      "properties": {
        "severity": { "$ref": "#/$defs/group" },
        "rule": {
          "enum": [
            "package-status",
            "class-status",
            "library-status",
            "beamer",
            "no-document-metadata",
            "misplaced-document-metadata",
            "pdftex-only",
            "no-language",
            "no-title",
            "missing-file",
            "outside-project",
            "include-parent-path",
            "outside-program"
          ]
        },
        "path": { "type": "string" },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "package": { "type": "string" },
        "kind": { "enum": ["package", "class", "library"] },
        "status": { "type": "string", "description": "The LaTeX Project's own status word." },
        "sourceComment": { "type": "string", "description": "The LaTeX Project's own comment, as written (markdown)." },
        "sourceLink": { "type": "string" },
        "via": { "type": "string", "description": "The name the source loaded, when it counted as a subpackage of `package`." },
        "message": { "type": "string" },
        "fix": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["name", "detail"],
              "additionalProperties": false,
              "properties": { "name": { "type": "string" }, "detail": { "type": "string" } }
            }
          ]
        },
        "excerpt": { "type": "string", "maxLength": 200 }
      }
    }
  }
}
