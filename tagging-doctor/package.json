{
  "name": "tagging-doctor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tagging Doctor: see what stops a LaTeX course project from producing a tagged PDF, scanned in the browser.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p image-test/tsconfig.json --noEmit",
    "lint": "eslint src test e2e image-test",
    "e2e": "playwright test",
    "status-data": "node scripts/convert-tagging-status.mjs",
    "test:image": "vitest run --config vitest.image.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@supabase/supabase-js": "^2.119.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "ajv": "^8.17.1",
    "axe-core": "4.14.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "yaml": "^2.6.1"
  }
}
