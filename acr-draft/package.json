{
  "name": "acr-draft",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ACR Draft: turn automated axe-core scans of your product plus a guided manual review into an honest WCAG 2.1 AA Accessibility Conformance Report (VPAT 2.5 WCAG edition), exported to Word or HTML. Runs entirely in your browser.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test"
  },
  "dependencies": {
    "axe-core": "4.11.0",
    "docx": "9.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "jszip": "^3.10.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
