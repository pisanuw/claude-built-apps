# Public build values (SPEC section 6), public by design: the anon key only
# reaches rows that row level security allows. Vite reads VITE_* at build
# time; in production deploy/target.yml's `env` sets them. A local `.env` with
# the same names is git-ignored. Without the first two the page runs in
# preview mode (no sign-in).
VITE_SUPABASE_URL=https://auth.hintwise.org
VITE_SUPABASE_ANON_KEY=
# The capture mount on backend-hub (used from milestone 3).
VITE_CHECK_URL=https://backend-hub-wk2e.onrender.com/heard-as-check
