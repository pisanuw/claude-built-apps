# backend-hub environment.
#
# The hub itself only reads PORT. Everything else belongs to the mounted apps.
# Convention: apps added after the hub was created use a name prefix
# (CHAT_..., DSA_...); mult-streak predates the hub and keeps its
# historical unprefixed names.

PORT=3000

# --- mult-streak (mounted at /mult-streak) ---
# Secret used to sign the game-state cookie. Required in production.
COOKIE_SECRET=change-me
# Minutes of inactivity before the "player stopped" email fires.
IDLE_MINUTES=5
# Resend credentials; email is disabled unless both are present.
RESEND_API=
ADMIN_EMAIL=
FROM_EMAIL=mult-streak@hintwise.org

# --- tagging-doctor (Tagging Doctor's checker, mounted at /tagging-doctor) ---
# Passed to the checker with the prefix taken off. The Docker image sets
# TAGGING_DOCTOR_CHECKER (the module) and TAGGING_DOCTOR_JOBS_ROOT; without
# TAGGING_DOCTOR_CHECKER the hub mounts a stand-in that takes no job.
TAGGING_DOCTOR_SUPABASE_URL=https://auth.hintwise.org
TAGGING_DOCTOR_SUPABASE_ANON_KEY=
# TAGGING_DOCTOR_CHECKER=../tagging-doctor-worker/src/mount.ts
# TAGGING_DOCTOR_ALLOW_LOCAL=1

# --- /chat (reserved for chatwithdigitalme) ---
# CHAT_...

# --- /dsa (reserved for dsa-instructor) ---
# DSA_...
