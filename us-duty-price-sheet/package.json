{
  "name": "us-duty-price-sheet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "US Duty Price Sheet: for UK makers who post to US customers with Royal Mail duty paid. A US tariff code per product, a US price and postage table with the duty included, and a list of prices to change when US duty changes. Runs entirely in your browser.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test scripts",
    "refresh-hts": "node scripts/fetch-hts.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
