# Deploy control file for SLUG (Netlify, static site with a Supabase schema).
# Rename to target.yml when the app first deploys; the deploy workflow
# auto-discovers `*/deploy/target.yml`.
#
# `supabase: true` makes the Deploy workflow run supabase/migrations/*.sql
# (node platform/supabase-admin.mjs migrate SLUG) and expose schema app_SLUG
# through PostgREST before the Netlify deploy. `env` carries the public client
# values from platform/supabase.json (public by design; the service-role key
# never appears here).
# package-lock.json is force-added (the root .gitignore excludes lockfiles)
# because `npm ci` below needs it.
#
# Code-only pushes do not trigger a deploy: the workflow watches this file, so
# touch it (or run the workflow manually) to ship UI changes.

provider: netlify
projectName: SLUG
directory: SLUG
build: npm ci && npm run build
publish: dist

supabase: true
env:
  VITE_SUPABASE_URL: https://REPLACE_WITH_REF.supabase.co
  VITE_SUPABASE_ANON_KEY: REPLACE_WITH_ANON_KEY

envPassthrough: []

netlify:
  # No serverless functions; the browser talks to Supabase and the gateway.
  functionsDir: ''
  siteName: SLUG
  # Primary domain; the runner swaps in APP_DOMAIN (hintwise.org) and creates the Cloudflare CNAME (DNS only).
  customDomain: SLUG.pisan.me
  accountSlug: yusuf-pisan
