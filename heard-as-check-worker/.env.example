# heard-as-check-worker settings (src/config.ts). None is a secret: the
# Supabase URL and anon key are public, the same the page ships.
# In backend-hub each name carries the prefix HEARD_AS_CHECK_ (for example
# HEARD_AS_CHECK_SUPABASE_URL); the hub strips it (backend-hub/src/capture.ts).
# Production values are in backend-hub/deploy/target.yml `env`; the rest are
# the image's defaults.
SUPABASE_URL=https://auth.hintwise.org
SUPABASE_ANON_KEY=
# The page's origin; the default is https://heard-as-check.hintwise.org.
ALLOWED_ORIGIN=
# Also give CORS permission to http://localhost:5173 (the app's dev server).
ALLOW_LOCAL=
# The job user (neither 0 nor 10001, the checker's TeX user) and its group.
JOB_UID=10002
JOB_GID=10002
JOBS_ROOT=/hac-jobs
CHROME=/opt/chrome/chrome-headless-shell
VERAPDF_HOME=/opt/verapdf
VERSIONS_DIR=/opt/versions
# pdf.js as installed; the default is node_modules/pdfjs-dist beside src/.
PDFJS_DIR=
# Places the job user can write to besides its job, emptied of its files after each job.
SWEEP_DIRS=/tmp,/var/tmp,/dev/shm
# The cgroup memory folder; empty finds v1 (/sys/fs/cgroup/memory) or v2 (/sys/fs/cgroup).
CGROUP_DIR=
# A shorter job limit for tests; never more than 90000.
JOB_MS=
# Chromium's fontconfig file; empty uses the system's.
FONTCONFIG_FILE=/opt/hac-fontconfig/fonts.conf
