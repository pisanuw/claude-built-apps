#!/usr/bin/env -S node --no-warnings=ExperimentalWarning
// The command-line tool, run from a clone of this repository: Node runs the
// TypeScript source in src/cli/ directly (Node 22.18 or newer; no npm
// install). Everyone else downloads the single-file version from
// https://lewis-alt-text.hintwise.org/terminal/ (built from the same source
// by scripts/build-cli.mjs; instructions in cli/INSTRUCTIONS.md).
import { readFileSync } from 'node:fs';
import { readFile } from 'node:fs/promises';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

if (!process.features.typescript) {
  console.error(`Running lewis-alt-text from the source needs Node.js 22.18 or newer (this is ${process.version}).
Or download the single-file version, which does not: https://lewis-alt-text.hintwise.org/terminal/`);
  process.exit(1);
}

const root = path.join(path.dirname(fileURLToPath(import.meta.url)), '..');
const pkg = JSON.parse(readFileSync(path.join(root, 'package.json'), 'utf8'));
const { run } = await import('../src/cli/run.ts');
await run({
  skill: () => readFile(path.join(root, 'skill', 'lewis-structure-alt-text-v8.txt'), 'utf8'),
  targetYml: () => readFileSync(path.join(root, 'deploy', 'target.yml'), 'utf8'),
  version: `${pkg.version} (from source)`,
  viaNode: false,
});
